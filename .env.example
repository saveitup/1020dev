# Anthropic API key for the audit endpoint.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Resend (email delivery for audit reports).
# Account in EU region recommended for data residency.
# Sign up: https://resend.com/
RESEND_API_KEY=re_...

# From-Adresse für Audit-Mails.
# Default: "1020.dev <onboarding@resend.dev>" — funktioniert nur für die Account-E-Mail.
# Sobald 1020.dev bei Resend per DNS verifiziert ist, auf
# z.B. "1020.dev <audit@1020.dev>" umstellen.
# RESEND_FROM=1020.dev <audit@1020.dev>

# BCC für Lead-Capture. Default: SITE.email (hallo@1020.dev).
# RESEND_BCC=hallo@1020.dev

# Cron-Secret für /api/cron/revalidate. Wird von Vercel-Cron im
# Authorization-Header mitgeschickt. Generieren mit:
#   openssl rand -base64 32
# Auf Vercel als Production Environment Variable setzen.
CRON_SECRET=

# Upstash Redis für persistentes Rate-Limiting auf /api/audit und
# /api/audit/track. Ohne diese Variablen fällt der Limiter auf einen
# in-memory-Bucket zurück (best-effort, pro Vercel-Instanz). Vor Go-Live
# anlegen: https://console.upstash.com/ → Redis-Database (EU-Region)
# → "REST API" tab → URL + Token kopieren.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Ads Conversion Tracking (alle drei Werte aus dem Google-Ads-UI).
# 1) Conversion-ID, Format "AW-XXXXXXXXX". Tools → Conversions → "Tag-Setup"
# 2) Conversion-Label "Erstgespräch buchen" (Cal.com-Klick)
#    Vollständige send_to: "AW-XXXXXXXXX/abcDef123"
# 3) Conversion-Label "AEO-Audit abgeschlossen"
#    Vollständige send_to: "AW-XXXXXXXXX/xyzAbc456"
# Ohne diese Vars wird gtag nicht geladen — die Site funktioniert normal weiter.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONV_BOOKING=
NEXT_PUBLIC_GOOGLE_ADS_CONV_AUDIT=
